From 967c6408cbaf637bed932a39350017220bc8b5b5 Mon Sep 17 00:00:00 2001
From: Festus B. Jejelowo <mail.festus@gmail.com>
Date: Mon, 2 Nov 2026 20:28:49 +0100
Subject: [PATCH 2/3] Let a gateway in front of Fincra hold the secret key

The secret key grants unrestricted Fincra API access, refunds and payouts
included. With secret_key_held_by_gateway set, the gateway at the API base URL
(an AgentSafe proxy) adds the api-key header itself: Drupal stores no secret
key, sends none, and keeps only the public key and the webhook key.
---
 .../schema/commerce_fincra_payment.schema.yml |  3 ++
 .../PaymentGateway/FincraStandard.php         | 29 +++++++++++++++++--
 src/Service/FincraCheckoutRedirectService.php | 20 ++++++++++---
 tests/src/Unit/ApiBaseUrlTest.php             | 14 +++++++++
 4 files changed, 60 insertions(+), 6 deletions(-)

diff --git a/config/schema/commerce_fincra_payment.schema.yml b/config/schema/commerce_fincra_payment.schema.yml
index 2a68e86..451d2e9 100644
--- a/config/schema/commerce_fincra_payment.schema.yml
+++ b/config/schema/commerce_fincra_payment.schema.yml
@@ -25,3 +25,6 @@ commerce_payment.commerce_payment_gateway.plugin.fincra_standard:
     api_base_url:
       type: string
       label: 'API base URL'
+    secret_key_held_by_gateway:
+      type: boolean
+      label: 'Secret key held by the gateway at the API base URL'
diff --git a/src/Plugin/Commerce/PaymentGateway/FincraStandard.php b/src/Plugin/Commerce/PaymentGateway/FincraStandard.php
index 7b2d8de..54ed52e 100644
--- a/src/Plugin/Commerce/PaymentGateway/FincraStandard.php
+++ b/src/Plugin/Commerce/PaymentGateway/FincraStandard.php
@@ -33,6 +33,9 @@ class FincraStandard extends OffsitePaymentGatewayBase implements FincraStandard
    * {@inheritdoc}
    */
   public function getSecretKey() {
+    if (!empty($this->configuration['secret_key_held_by_gateway'])) {
+      return '';
+    }
     $mode = $this->getMode() ?? 'test';
     return $this->configuration["secret_key_{$mode}"] ?? '';
   }
@@ -90,6 +93,7 @@ class FincraStandard extends OffsitePaymentGatewayBase implements FincraStandard
         'webhook_key'     => '',
         'debug_payload'   => '',
         'api_base_url'    => '',
+        'secret_key_held_by_gateway' => FALSE,
       ] + parent::defaultConfiguration();
   }
 
@@ -190,6 +194,13 @@ class FincraStandard extends OffsitePaymentGatewayBase implements FincraStandard
       '#default_value' => $this->configuration['api_base_url'] ?? '',
     ];
 
+    $form['secret_key_held_by_gateway'] = [
+      '#type' => 'checkbox',
+      '#title' => $this->t('The secret key is held by the gateway at the API base URL'),
+      '#description' => $this->t('For a gateway such as AgentSafe that adds the api-key header itself. Drupal then stores no secret key and sends none.'),
+      '#default_value' => !empty($this->configuration['secret_key_held_by_gateway']),
+    ];
+
     $form['debug_payload'] = [
       '#type' => 'checkbox',
       '#title' => $this->t('Debug payload'),
@@ -218,8 +229,16 @@ class FincraStandard extends OffsitePaymentGatewayBase implements FincraStandard
       $secret_key = $values["secret_key_{$mode}"];
       $public_key = $values["public_key_{$mode}"];
 
-      // Validate secret key.
-      if (!is_string($secret_key)) {
+      $held = !empty($values['secret_key_held_by_gateway']);
+      if ($held && $base_url === '') {
+        $form_state->setError($form['api_base_url'], $this->t('Set the API base URL of the gateway that holds the secret key.'));
+      }
+
+      // Validate secret key, unless a gateway in front of Fincra holds it.
+      if ($held) {
+        // Nothing to check: the key is not stored here.
+      }
+      elseif (!is_string($secret_key)) {
         $form_state->setError($form["secret_key_{$mode}"], $this->t('A valid Fincra secret key must be a string.'));
       }
       elseif (strlen($secret_key) <= 14) {
@@ -248,6 +267,12 @@ class FincraStandard extends OffsitePaymentGatewayBase implements FincraStandard
       $this->configuration['business_id']     = $values['business_id'];
       $this->configuration['debug_payload']   = $values['debug_payload'];
       $this->configuration['api_base_url']    = rtrim(trim((string) ($values['api_base_url'] ?? '')), '/');
+      $this->configuration['secret_key_held_by_gateway'] = !empty($values['secret_key_held_by_gateway']);
+      if ($this->configuration['secret_key_held_by_gateway']) {
+        // The gateway holds the key; keep no copy in Drupal's configuration.
+        $this->configuration['secret_key_test'] = '';
+        $this->configuration['secret_key_live'] = '';
+      }
     }
   }
 
diff --git a/src/Service/FincraCheckoutRedirectService.php b/src/Service/FincraCheckoutRedirectService.php
index dfff487..c5902ee 100644
--- a/src/Service/FincraCheckoutRedirectService.php
+++ b/src/Service/FincraCheckoutRedirectService.php
@@ -55,9 +55,8 @@ class FincraCheckoutRedirectService {
         'headers' => [
           'Accept' => 'application/json',
           'Content-Type' => 'application/json',
-          'api-key' => $gateway->getSecretKey(),
           'x-pub-key' => $gateway->getPublicKey(),
-        ],
+        ] + $this->secretKeyHeader($gateway),
         'json' => $params,
       ]);
 
@@ -85,9 +84,8 @@ class FincraCheckoutRedirectService {
         'headers' => [
           'Accept' => 'application/json',
           'Content-Type' => 'application/json',
-          'api-key' => $gateway->getSecretKey(),
           'x-business-id' => $gateway->getBusinessId(),
-        ],
+        ] + $this->secretKeyHeader($gateway),
       ]);
 
       $data = json_decode($response->getBody()->getContents(), TRUE);
@@ -102,4 +100,18 @@ class FincraCheckoutRedirectService {
     }
   }
 
+  /**
+   * The api-key header, unless a gateway in front of Fincra adds it.
+   *
+   * @param \Drupal\commerce_fincra\Plugin\Commerce\PaymentGateway\FincraStandardInterface $gateway
+   *   The payment gateway plugin.
+   *
+   * @return array
+   *   The header, or nothing when the key is held by the gateway.
+   */
+  protected function secretKeyHeader(FincraStandardInterface $gateway): array {
+    $key = (string) $gateway->getSecretKey();
+    return $key === '' ? [] : ['api-key' => $key];
+  }
+
 }
diff --git a/tests/src/Unit/ApiBaseUrlTest.php b/tests/src/Unit/ApiBaseUrlTest.php
index f4d6107..0cfc3df 100644
--- a/tests/src/Unit/ApiBaseUrlTest.php
+++ b/tests/src/Unit/ApiBaseUrlTest.php
@@ -80,4 +80,18 @@ class ApiBaseUrlTest extends UnitTestCase {
     $this->assertFalse(FincraStandard::isAllowedBaseUrl('ftp://api.fincra.com'));
   }
 
+  /**
+   * Tests that no api-key header is sent while a gateway holds the key.
+   */
+  public function testNoSecretKeyIsSentWhenTheGatewayHoldsIt(): void {
+    $service = $this->service([
+      new Response(200, [], '{"status":true,"data":{}}'),
+      new Response(200, [], '{"status":true,"data":{}}'),
+    ]);
+    $service->createCheckoutRedirect(['amount' => 100], $this->gateway('http://127.0.0.1:8787', ''));
+    $service->createCheckoutRedirect(['amount' => 100], $this->gateway('https://api.fincra.com'));
+    $this->assertFalse($this->history[0]['request']->hasHeader('api-key'));
+    $this->assertSame('aaaaaaaaaaaaaaaa', $this->history[1]['request']->getHeaderLine('api-key'));
+  }
+
 }
