+  /**
+   * {@inheritdoc}
+   */
+  /**
+   * Checks an API base URL: HTTPS, or HTTP on the loopback interface only.
+   */
+  public static function isAllowedBaseUrl(string $url): bool {
+    $parts = parse_url($url);
+    if ($parts === FALSE || empty($parts['host']) || isset($parts['user']) || isset($parts['pass']) || isset($parts['query']) || isset($parts['fragment'])) {
+      return FALSE;
+    }
+    $scheme = $parts['scheme'] ?? '';
+    return $scheme === 'https' || ($scheme === 'http' && in_array($parts['host'], ['127.0.0.1', 'localhost', '[::1]'], TRUE));
+  }
+
   /**
    * {@inheritdoc}
    */
