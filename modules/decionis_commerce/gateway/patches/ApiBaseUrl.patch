diff --git a/tests/src/Unit/ApiBaseUrlTest.php b/tests/src/Unit/ApiBaseUrlTest.php
new file mode 100644
index 0000000..f4d6107
--- /dev/null
+++ b/tests/src/Unit/ApiBaseUrlTest.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace Drupal\Tests\commerce_fincra\Unit;
+
+use Drupal\commerce_fincra\Plugin\Commerce\PaymentGateway\FincraStandard;
+use Drupal\commerce_fincra\Plugin\Commerce\PaymentGateway\FincraStandardInterface;
+use Drupal\commerce_fincra\Service\FincraCheckoutRedirectService;
+use Drupal\Core\Logger\LoggerChannelFactoryInterface;
+use Drupal\Core\Logger\LoggerChannelInterface;
+use Drupal\Tests\UnitTestCase;
+use GuzzleHttp\Client;
+use GuzzleHttp\Handler\MockHandler;
+use GuzzleHttp\HandlerStack;
+use GuzzleHttp\Middleware;
+use GuzzleHttp\Psr7\Response;
+
+/**
+ * Requests go to the configured API base URL, so a proxy can front Fincra.
+ *
+ * @group commerce_fincra
+ */
+class ApiBaseUrlTest extends UnitTestCase {
+
+  /**
+   * The requests the mocked HTTP client received.
+   *
+   * @var array
+   */
+  protected array $history = [];
+
+  /**
+   * Builds the service over a mocked HTTP client answering $responses.
+   */
+  protected function service(array $responses): FincraCheckoutRedirectService {
+    $stack = HandlerStack::create(new MockHandler($responses));
+    $stack->push(Middleware::history($this->history));
+    $logger = $this->createMock(LoggerChannelFactoryInterface::class);
+    $logger->method('get')->willReturn($this->createMock(LoggerChannelInterface::class));
+    return new FincraCheckoutRedirectService(new Client(['handler' => $stack]), $logger);
+  }
+
+  /**
+   * A gateway with the given base URL and secret key.
+   */
+  protected function gateway(string $baseUrl, string $secretKey = 'aaaaaaaaaaaaaaaa'): FincraStandardInterface {
+    $gateway = $this->createMock(FincraStandardInterface::class);
+    $gateway->method('getApiBaseUrl')->willReturn($baseUrl);
+    $gateway->method('getSecretKey')->willReturn($secretKey);
+    $gateway->method('getPublicKey')->willReturn('pk_test_0123456789');
+    $gateway->method('getBusinessId')->willReturn('business-1');
+    $gateway->method('getMode')->willReturn('test');
+    return $gateway;
+  }
+
+  /**
+   * Tests that checkout and verification use the configured base URL.
+   */
+  public function testRequestsUseTheConfiguredBaseUrl(): void {
+    $service = $this->service([
+      new Response(200, [], '{"status":true,"data":{"link":"https://checkout.fincra.com/x"}}'),
+      new Response(200, [], '{"status":true,"data":{"status":"success"}}'),
+    ]);
+    $gateway = $this->gateway('http://127.0.0.1:8787');
+    $service->createCheckoutRedirect(['amount' => 100], $gateway);
+    $service->verifyTransaction('ref-1', $gateway);
+    $this->assertSame('http://127.0.0.1:8787/checkout/payments', (string) $this->history[0]['request']->getUri());
+    $this->assertSame('http://127.0.0.1:8787/checkout/payments/merchant-reference/ref-1', (string) $this->history[1]['request']->getUri());
+  }
+
+  /**
+   * Tests which base URLs the form accepts.
+   */
+  public function testOnlyHttpsOrALoopbackProxyIsAccepted(): void {
+    $this->assertTrue(FincraStandard::isAllowedBaseUrl('https://api.fincra.com'));
+    $this->assertTrue(FincraStandard::isAllowedBaseUrl('http://127.0.0.1:8787'));
+    $this->assertTrue(FincraStandard::isAllowedBaseUrl('http://localhost:8787'));
+    $this->assertFalse(FincraStandard::isAllowedBaseUrl('http://proxy.example.com'));
+    $this->assertFalse(FincraStandard::isAllowedBaseUrl('https://user:pass@api.fincra.com'));
+    $this->assertFalse(FincraStandard::isAllowedBaseUrl('https://api.fincra.com/?x=1'));
+    $this->assertFalse(FincraStandard::isAllowedBaseUrl('ftp://api.fincra.com'));
+  }
+
+}
