<?php

/**
 * @file
 * Procedural hook shims for Drupal 10.
 *
 * Drupal 11.1+ runs the same methods through the attributes on
 * \Drupal\decionis\Hook\CoreHooks.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\decionis\Hook\CoreHooks;

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function decionis_cron(): void {
  \Drupal::service(CoreHooks::class)->cron();
}

/**
 * Implements hook_entity_insert().
 */
#[LegacyHook]
function decionis_entity_insert(EntityInterface $entity): void {
  \Drupal::service(CoreHooks::class)->entityInsert($entity);
}

/**
 * Implements hook_entity_update().
 */
#[LegacyHook]
function decionis_entity_update(EntityInterface $entity): void {
  \Drupal::service(CoreHooks::class)->entityUpdate($entity);
}

/**
 * Implements hook_mail().
 */
#[LegacyHook]
function decionis_mail(string $key, array &$message, array $params): void {
  \Drupal::service(CoreHooks::class)->mail($key, $message, $params);
}

/**
 * Implements hook_form_FORM_ID_alter() for system_cron_settings.
 */
#[LegacyHook]
function decionis_form_system_cron_settings_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(CoreHooks::class)->cronForm($form, $form_state);
}
